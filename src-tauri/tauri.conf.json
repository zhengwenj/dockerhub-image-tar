{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DockerHub Image Tar",
  "version": "1.0.0",
  "identifier": "cn.com.mlqk.dockerhub-image-tar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DockerHub Image Tar",
        "width": 1180,
        "height": 860,
        "minWidth": 980,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
